# Copy this file to ".env" and adjust the values.
# (If .env does not exist, the API creates it from this file the first time it runs.)

# --- Server ---
PORT=5000
NODE_ENV=development
# Address of the website (the frontend repo). Separate several addresses with commas.
CLIENT_URL=http://localhost:5173

# --- MySQL (XAMPP defaults: user "root", empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ced_website
DB_USER=root
DB_PASSWORD=

# --- Shared hosting (e.g. Hostinger) ---
# Database connections this API may keep open. Keep it below your host's per-user limit.
DB_POOL_MAX=3
# Set to false if your host does not let the database user create databases (create it in the control panel).
DB_CREATE=true
# How long public data is kept in memory, in seconds (0 turns the cache off).
CACHE_SECONDS=60

# --- Admin login ---
# Leave this as it is: a long random secret is put here automatically on first run.
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# First admin account, created by "npm run seed". Change the password after the first sign-in.
ADMIN_NAME=CED Admin
ADMIN_EMAIL=admin@cedpioneers.com
ADMIN_PASSWORD=ChangeMe@2026
